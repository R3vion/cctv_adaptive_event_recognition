# Copy to .env and adjust. Every key is optional; defaults are shown.
# Values saved on the Settings page override these.

# --- Ollama (external service) ---------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434/
OLLAMA_MODEL=qwen3.6:27b
OLLAMA_NUM_CTX=32768
OLLAMA_TIMEOUT_S=300
OLLAMA_KEEP_ALIVE=30m
THINK_CONDITION=true
THINK_OBSERVATION=false
THINK_DECISION=true
LLM_RETRIES=3
# 0 = send frames in original resolution
VLM_MAX_IMAGE_SIDE=0

# --- Analysis ---------------------------------------------------------------
# auto | manual
ANALYSIS_MODE=auto
EPISODE_GAP_S=15
EPISODE_IDLE_CLOSE_S=30
CAMERA_MEMORY_HOURS=24

# --- Adaptive frame selection ----------------------------------------------
# pixel_hist | optical_flow
SELECTION_MODE=pixel_hist
# 0 = auto (median + k*1.4826*MAD of the frame-to-frame change, per video)
SELECTION_THRESHOLD=0
SELECTION_AUTO_K=6
SELECTION_W_PIXEL=0.7
SELECTION_W_HIST=0.3
FRAMES_MIN=5
FRAMES_MAX=30
FRAME_SCOPE_FRAMES=3
SIGNAL_FPS=15
SIGNAL_SIDE=320
PIXEL_DELTA=25

# --- System -----------------------------------------------------------------
LOG_LEVEL=INFO

# Host port of the web UI (docker compose)
APP_PORT=8000
